<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.belsekolah.MainApp">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <!-- KIRI: PANEL UTAMA -->
    <VBox spacing="12" HBox.hgrow="ALWAYS" prefWidth="480">
        <!-- Header Aplikasi -->
        <VBox alignment="CENTER" spacing="2" styleClass="card">
            <Label text="Bel Sekolah" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
            <Label fx:id="lblNamaLembaga" text="SDI Miftahul Ulum Klemunan" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
        </VBox>

        <!-- Card 1: Informasi Waktu & Tanggal -->
        <VBox spacing="10" styleClass="card">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox HBox.hgrow="ALWAYS">
                    <!-- Hari & Tanggal -->
                    <Label fx:id="lblHari" text="Rabu, 29 Juli 2026" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />
                    <!-- Jam Utama (Digital Clock) -->
                    <Label fx:id="lblJam" text="07:04:19" style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;" />
                </VBox>
                <Label fx:id="lblStatus" text="Status: Menunggu" style="-fx-background-color: #e3f2fd; -fx-text-fill: #0d47a1; -fx-padding: 6 12; -fx-background-radius: 15; -fx-font-weight: bold;" />
            </HBox>

            <VBox spacing="4" style="-fx-background-color: #f8f9fa; -fx-padding: 8; -fx-background-radius: 6;">
                <Label text="JADWAL BERIKUTNYA" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" />
                <Label fx:id="lblJadwalBerikutnya" text="07:05   Bel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            </VBox>
        </VBox>

        <!-- Card 2: Central Player Control & Running Text -->
        <VBox spacing="10" styleClass="card" style="-fx-padding: 5px; -fx-background-color: #ffffff; -fx-border-color: #bbdefb; -fx-border-radius: 8;">
            <Label text="Pemutar Audio Utama" styleClass="card-header" style="-fx-font-weight: bold;" />

            <!-- Running Text Display -->
            <Pane fx:id="paneRunningText" prefHeight="35" style="-fx-background-color: #1a1a1a;">
                <Label fx:id="lblRunningText" text="Tidak ada audio diputar" layoutY="7" style="-fx-text-fill: #00ffcc; -fx-font-family: 'Monospaced'; -fx-font-size: 13px; -fx-font-weight: bold;" />
            </Pane>
            <ComboBox fx:id="cbCustomAudio" maxWidth="Infinity" promptText="-- Pilih File Suara --" HBox.hgrow="ALWAYS" />
            <!-- Control Buttons (Diatur Status Awal Disable) -->
            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="btnCentralPlay" disable="true" onAction="#handleCentralPlay" text="▶" style="-fx-font-size: 14px; -fx-min-width: 45px;" />
                <Button fx:id="btnCentralPause" disable="true" onAction="#handleCentralPause" text="⏸" style="-fx-font-size: 14px; -fx-min-width: 45px;" />
                <Button fx:id="btnCentralStop" disable="true" onAction="#handleCentralStop" text="⏹" style="-fx-font-size: 14px; -fx-min-width: 45px;" />
<!--                <ToggleButton fx:id="btnCentralRepeat" onAction="#handleCentralRepeat" text="🔁" style="-fx-font-size: 14px; -fx-min-width: 45px;" />-->
            </HBox>
        </VBox>

        <!-- Card 4: Lagu Hari Ini -->
        <VBox spacing="10" styleClass="card">
            <Label text="Lagu Hari Ini" styleClass="card-header" style="-fx-font-weight:bold;"/>
            <VBox fx:id="containerLaguHariIni" spacing="6" />
        </VBox>

        <Button fx:id="btnToggleJadwal" onAction="#toggleJadwalPanel" text="Sembunyikan Jadwal" maxWidth="Infinity" />
        <Hyperlink onAction="#openGithub" text="Tentang program" alignment="CENTER" maxWidth="Infinity" />
    </VBox>

    <!-- KANAN: PANEL JADWAL -->
    <VBox fx:id="panelJadwal" spacing="10" styleClass="card" prefWidth="350">
        <Label text="Jadwal Hari Ini" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <TableView fx:id="tableJadwal" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colJam" text="Jam" />
                <TableColumn fx:id="colJadwal" text="Jadwal" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Button fx:id="btnTambahJadwal" onAction="#handleTambahJadwal" text="Tambah" styleClass="btn-primary" />
            <Button fx:id="btnEditJadwal" onAction="#handleEditJadwal" text="Edit" />
            <Button fx:id="btnHapusJadwal" onAction="#handleHapusJadwal" text="Hapus" styleClass="btn-danger" />
        </HBox>
    </VBox>
</HBox>